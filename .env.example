# Copiar a .env (o .env.local) y ajustar. .env esta en .gitignore.

# Destino del backend en desarrollo; vite.config.js reenvia /api y /auth ahi.
# Sin prefijo VITE_ para que no acabe en el bundle del navegador.
API_PROXY_TARGET=http://localhost:8080

# URL absoluta del API cuando el frontend no comparte dominio con el backend.
# En desarrollo se deja vacia: el cliente usa rutas relativas y el proxy.
# En Cloudflare Pages se define en Settings > Environment variables y se inyecta
# en el build (si cambia la URL del backend hay que volver a desplegar).
# VITE_API_URL=https://easycar-api.onrender.com
